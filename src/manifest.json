{
  "manifest_version": 2,
  "name": "New Tab Homepage",
  "version": "0.7.0",
  "description": "Loads your homepage when you open a new tab.",
  "author": "Ben Basson",
  "homepage_url": "http://www.basson.at/firefox-addons/newtabhomepage",
  "permissions": [
    "tabs",
    "browserSettings",
    "history",
    "sessions"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "chrome_settings_overrides": {},
  "chrome_url_overrides": {
    "newtab": "redirect.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "new-tab-homepage@ea.net",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}